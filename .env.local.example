# คัดลอกไฟล์นี้เป็น ".env.local" แล้วใส่ค่าของพี่ตรงนี้
# (ห้ามใส่ค่าจริงใน .env.local.example และห้าม commit .env.local ขึ้น git)

ANTHROPIC_API_KEY=ใส่_api_key_ของพี่ตรงนี้

# ค่าจาก Supabase (เฟส 3) — เอามาจาก Settings → API ในหน้า project ของพี่
NEXT_PUBLIC_SUPABASE_URL=ใส่_project_url_ตรงนี้
NEXT_PUBLIC_SUPABASE_ANON_KEY=ใส่_anon_public_key_ตรงนี้
